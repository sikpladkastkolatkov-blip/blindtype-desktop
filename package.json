{
  "name": "swift-nimble-exact-input-system",
  "version": "1.0.0",
  "description": "Русский тренажёр слепой печати для Windows",
  "main": "main.js",
  "author": "Swift Nimble Exact Input System",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg --arm64 --publish never && electron-builder --mac dmg --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.swiftnimble.desktop",
    "productName": "Swift Nimble Exact Input System",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Swift-Nimble-Exact-Input-System-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Swift Nimble Exact Input System"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Swift-Nimble-Exact-Input-System-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Swift Nimble Exact Input System"
    },
    "afterPack": "afterPack.js"
  }
}
